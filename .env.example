# Documentation only: Spring Boot does not load this file automatically.
# Human-readable local logs with com.fitlake DEBUG; use prod for ECS JSON stdout.
SPRING_PROFILES_ACTIVE=dev

DATABASE_URL=jdbc:postgresql://localhost:5432/fitlake
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

OPENAI_API_KEY=
OPENAI_LOG=off
# Keep disabled until OPENAI_API_KEY and an OpenAI-compatible chat model are configured.
SPRING_AI_MODEL_CHAT=none
SPRING_AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1
SPRING_AI_OPENAI_CHAT_MODEL=
SPRING_AI_OPENAI_CHAT_MAX_TOKENS=4096
FITLAKE_DAILY_AI_MAX_TEXT_LENGTH=4000
FITLAKE_DAILY_AI_MAX_STRUCTURED_OUTPUT_RETRIES=1
# Enable only when the selected provider/model lists JSON Schema structured-output support.
FITLAKE_DAILY_AI_NATIVE_STRUCTURED_OUTPUT_ENABLED=false
FITLAKE_DAILY_AI_FOOD_MATCH_MINIMUM_SCORE=0.4
FITLAKE_DAILY_AI_FOOD_MATCH_MINIMUM_MARGIN=0.12

FIREBASE_PROJECT_ID=
# Use an absolute path to a credential file stored outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/outside/fitlake/firebase-service-account.json

FITLAKE_DEFAULT_TIMEZONE=Europe/Rome
