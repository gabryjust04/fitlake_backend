# Documentation only: Spring Boot does not load this file automatically.
DATABASE_URL=jdbc:postgresql://localhost:5432/fitlake
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

OPENAI_API_KEY=
# Keep disabled until OPENAI_API_KEY and a tool-capable model are configured.
SPRING_AI_MODEL_CHAT=none
SPRING_AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1
SPRING_AI_OPENAI_CHAT_MODEL=
SPRING_AI_OPENAI_CHAT_MAX_TOKENS=4096
FITLAKE_DAILY_AI_MAX_TEXT_LENGTH=4000

FIREBASE_PROJECT_ID=
# Use an absolute path to a credential file stored outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/outside/fitlake/firebase-service-account.json

FITLAKE_DEFAULT_TIMEZONE=Europe/Rome
